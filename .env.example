# ------------------------------------------------------------------------------
# Caw — NetEase Cloud Music OpenAPI credentials (dev only)
#
# Copy this file to .env and fill in your own values. .env is gitignored.
# These are read at backend startup and OVERRIDE whatever is stored in
# ~/.config/caw/config.json, so you don't have to retype them in Settings.
#
# Where to get them:
#   https://developer.music.163.com/st/developer/apply/account?type=INDIVIDUAL
#   Console → 开发管理 → 基本配置 → appId / 服务端公钥
# ------------------------------------------------------------------------------

# The appId assigned to your app.
CAW_NETEASE_APP_ID=

# Your RSA private key, PKCS#8, 2048-bit, base64, SINGLE LINE.
# Strip the "-----BEGIN PRIVATE KEY-----" / "-----END PRIVATE KEY-----" lines
# and all newlines. Generate a pair with:
#   openssl genrsa -out app_private_key.pem 2048
#   openssl pkcs8 -topk8 -inform PEM -in app_private_key.pem -outform PEM -nocrypt -out app_private_key_pkcs8.pem
#   openssl rsa -in app_private_key.pem -pubout -out app_public_key.pem
# Upload app_public_key.pem (also stripped to one line) to the console; keep the
# private key here.
CAW_NETEASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# Device fingerprint. The platform validates these against what your appId is
# registered for and rejects mismatches with:
# code 400 "公共参数校验失败，请检查os/channel/brand等是否符合约定"
# Ask your platform contact which values your appId expects, then set them here.
# ------------------------------------------------------------------------------
CAW_NETEASE_OS=
CAW_NETEASE_CHANNEL=
CAW_NETEASE_BRAND=
CAW_NETEASE_DEVICE_TYPE=openapi
CAW_NETEASE_MODEL=
CAW_NETEASE_APP_VER=

# API host. Two different product lines exist — see docs/netease-openapi.md:
#   openncm.music.163.com   personal/user-authorized  /openapi/music/basic/*
#   openapi.music.163.com   B2B sublicense (needs bizId)  /openapi/music/authority/*
CAW_NETEASE_API_HOST=openncm.music.163.com

# Only for the B2B sublicense line: the material-library id assigned to you.
CAW_NETEASE_BIZ_ID=