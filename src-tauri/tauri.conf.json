{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caw",
  "version": "0.2.0",
  "identifier": "cn.cyber-nest.caw",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Caw",
        "width": 1600,
        "height": 1200,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "transparent": false,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64 | libasound2"
        ],
        "recommends": [
          "pipewire-alsa | libasound2-plugins"
        ]
      },
      "rpm": {
        "depends": [
          "alsa-lib"
        ],
        "recommends": [
          "pipewire-alsa"
        ]
      }
    }
  }
}